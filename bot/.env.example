# Скопируй в .env и впиши. Файл .env в git не попадает.
TELEGRAM_BOT_TOKEN=
# Твой личный номер чата. Бот отвечает ТОЛЬКО ему (см. README, шаг 3).
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
# Папка, где лежит клон репозитория jarvis (по умолчанию — на уровень выше bot/)
JARVIS_DIR=
# Модель для /ask (по умолчанию claude-sonnet-5-5)
JARVIS_MODEL=
# 1 = разрешить /code (запуск Claude Code на компьютере). По умолчанию выключено.
ENABLE_CODE=0
